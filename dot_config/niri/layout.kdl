layout {
    gaps 4

    border {
        width 2
        active-color   "#c6a0f6"
        inactive-color "#6e738d"
        urgent-color   "#ed8796"
    }

    focus-ring {
        width 2
        active-color   "#c6a0f6"
        inactive-color "#6e738d"
        urgent-color   "#ed8796"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#c6a0f6"
        inactive-color "#6e738d"
        urgent-color   "#ed8796"
    }

    insert-hint {
        color "#c6a0f680"
    }
}

recent-windows {
    highlight {
        active-color   "#532f7d"
        urgent-color   "#ed8796"
    }
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    tiled-state true
    draw-border-with-background false
}
